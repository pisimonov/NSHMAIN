# Отчёт «Накопленная выручка». Защита служебных файлов.
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.sample\.php|README.*|.*\.md|.*\.json|.*\.log|.*\.lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
